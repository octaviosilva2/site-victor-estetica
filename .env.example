# Identificador do container do Google Tag Manager.
#
# Sem esta variável definida, nenhum script de medição é injetado e o site
# roda exatamente como antes da instrumentação. É o que permite desenvolver
# localmente sem mandar dado de teste para a base do cliente.
#
# Copiar para .env.local (ignorado pelo git) para usar em desenvolvimento,
# e cadastrar no painel da hospedagem para preview e produção.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# =============================================================================
# PAINEL DO CLIENTE — dados.victorfolster.com.br
# =============================================================================
# As 10 variáveis abaixo NÃO valem para o site: só o painel as usa. Estão todas
# cadastradas na hospedagem, em Production. Nenhum valor real aparece aqui.
#
# Onde o painel não encontra uma delas, ele falha com o nome da que faltou — e
# não com um painel vazio, que pareceria falta de dado.

# --- Leitura do Analytics ---------------------------------------------------
# Identidade federada: a hospedagem emite um token, o Google o troca por uma
# credencial que representa uma conta de serviço com papel de Leitor na
# propriedade. Não existe chave privada, e portanto não existe o que rotacionar.
GA4_PROPERTY_ID=000000000
GCP_PROJECT_NUMBER=000000000000
GCP_WORKLOAD_IDENTITY_POOL_ID=nome-do-pool
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=nome-do-provedor
GCP_SERVICE_ACCOUNT_EMAIL=conta-de-servico@projeto.iam.gserviceaccount.com

# --- Acesso ao painel -------------------------------------------------------
# Segredo que assina o cookie de sessão. Gerar com `npx auth secret`.
AUTH_SECRET=

# Credenciais do consentimento OAuth. O consentimento precisa estar PUBLICADO —
# em modo de teste a sessão do cliente expira a cada 7 dias e ele é deslogado
# sem entender por quê.
#
# O URI de redirecionamento autorizado precisa ser exatamente:
#   https://dados.victorfolster.com.br/api/auth/callback/google
# Sem ele, o Google recusa a volta do login com `redirect_uri_mismatch`.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# O único endereço que pode ver o painel. Um só — mais de um usuário está
# declarado fora do escopo em `05-escopo-contratado.md`, seção 12.4.
#
# Se esta variável faltar, NINGUÉM entra. É deliberado: ausente por engano, ela
# abriria o painel do cliente para qualquer conta Google do mundo.
PAINEL_EMAIL_AUTORIZADO=
