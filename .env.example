# ============================================
# Domínio de produção
#
# Usado nas tags canônicas, no og:url, no sitemap.xml e nos dados
# estruturados. Só é necessário definir aqui para apontar para outro
# ambiente (staging): sem a variável, o padrão é o domínio de produção
# definido em src/lib/seo.ts.
# ============================================

# VITE_SITE_URL=https://victorfolster.com.br

# ============================================
# Avaliações do Google (seção "O que dizem no Google")
#
# Sem estas duas variáveis a seção de avaliações não aparece no site.
# Copie este arquivo para .env e preencha os valores.
#
# 1. Google Cloud Console → habilitar "Places API (New)" → criar API key.
# 2. Restringir a key por referenciador HTTP (domínio do site): ela fica
#    visível no navegador, e a restrição é o que impede uso indevido.
# 3. Place ID do perfil do Google Meu Negócio:
#    https://developers.google.com/maps/documentation/places/web-service/place-id
# ============================================

VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
